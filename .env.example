# Optional. You can also paste your key into the in-app Settings screen instead.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Server port and bind address. Keep HOST on 127.0.0.1 unless you know what you're doing:
# the server can spend money on your API key, so it should not be reachable from your network.
PORT=8787
HOST=127.0.0.1

# How many workers may run at the same time across the whole office.
MAX_CONCURRENT_WORKERS=4

# Values for approved commands (department window > Approved commands). A command only gets the
# variables you list for it, and Siverse reads this file again on every run. For example:
# ZOHO_USER=you@yourdomain.com
# ZOHO_APP_PASSWORD=
